// Prisma schema for fb-operations-enhancer MVP
// Generated from finalized domain model with all invariants verified

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum RoleType {
  ADMIN
  MANAGER
  STAFF
  VIEWER
}

enum OperationalDesignation {
  GM              // General Manager (cannot have RL)
  OM              // Operations Manager (cannot have RL)
  SUPERVISOR
  CAPTAIN
  STEWARD
  BARISTA
}

enum RosterGroup {
  SUPERVISORS
  CAPTAINS
  STEWARDS
  BARISTAS
  OTHER
}

enum AssignmentCode {
  FIRST_SHIFT
  SECOND_SHIFT
  RL              // Royal Shift (opening to closing)
  WO              // Weekly Off
}

enum NormalRotationState {
  FIRST_SHIFT
  SECOND_SHIFT
}

enum ReportingGroup {
  FIRST_SHIFT
  SECOND_SHIFT
  NONE
}

enum RosterWeekStatus {
  DRAFT
  READY_FOR_REVIEW
  PENDING_APPROVALS
  PUBLISHED
  ARCHIVED
}

enum RosterGenerationJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum RLProposalStatus {
  PROPOSED
  APPROVED
  REJECTED
  CANCELLED
}

enum BRKApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UnavailabilityReason {
  LEAVE
  MEDICAL
  EMERGENCY
  TRAINING
  OTHER
}

enum ValidationType {
  MINIMUM_STAFFING
  RL_CONFLICT
  BRK_OVERLAP
  ASSIGNMENT_CONFLICT
  CONFIG_ERROR
  ROTATION_ERROR
  UNKNOWN
}

enum ValidationSeverity {
  ERROR
  WARNING
  INFO
}

enum DutyCode {
  OPENING
  CLOSING
  BREAK
  MEAL_BREAK
  TRAINING
  OTHER
}

// ============================================================================
// AUTH & USERS
// ============================================================================

model User {
  id                String    @id @default(cuid())
  email             String
  password_hash     String
  full_name         String
  role              RoleType
  is_active         Boolean   @default(true)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  last_login_at     DateTime?

  // Relations
  staff             Staff?
  rl_approvals      RLProposal[]     @relation("rl_approved_by")
  brk_approvals     DailyOperationalDuty[] @relation("brk_approved_by")
  override_audits   RosterOverride[]
  validation_audits RosterValidationResult[]
  unavailability_created StaffUnavailability[] @relation("unavailability_created_by")

  @@index([email])
}

// ============================================================================
// STAFF & ORGANIZATIONAL STRUCTURE
// ============================================================================

model Staff {
  id                      String   @id @default(cuid())
  user_id                 String   @unique
  operational_designation OperationalDesignation
  roster_group            RosterGroup
  is_available            Boolean  @default(true)
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  // Relations
  user                           User    @relation(fields: [user_id], references: [id], onDelete: Restrict)
  weekly_off_config              StaffWeeklyOffConfig?
  roster_assignments             RosterAssignment[]
  rl_proposals                   RLProposal[]
  unavailability_records         StaffUnavailability[]
  daily_operational_duties       DailyOperationalDuty[]
  roster_overrides               RosterOverride[]

  @@index([operational_designation])
  @@index([roster_group])
  @@index([is_available])
}

model StaffWeeklyOffConfig {
  id               String     @id @default(cuid())
  staff_id         String   @unique
  weekly_off_day   Int        // 0 = Monday, 6 = Sunday
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt

  // Relations
  staff            Staff      @relation(fields: [staff_id], references: [id], onDelete: Cascade)

  @@unique([staff_id, weekly_off_day])
  @@index([staff_id])
}

model StaffUnavailability {
  id        String   @id @default(cuid())
  staff_id  String
  reason    UnavailabilityReason
  start_date DateTime
  end_date  DateTime
  notes     String?
  created_by String
  created_at DateTime @default(now())

  // Relations
  staff               Staff   @relation(fields: [staff_id], references: [id], onDelete: Cascade)
  creator             User    @relation("unavailability_created_by", fields: [created_by], references: [id], onDelete: Restrict)

  @@index([staff_id])
  @@index([start_date, end_date])
  @@index([created_by])
}

// ============================================================================
// ROSTER CONFIGURATION
// ============================================================================

model RosterConfig {
  id              String   @id @default(cuid())
  config_key      String   // e.g., FIRST_SHIFT_REPORTING_TIME, SECOND_SHIFT_REPORTING_TIME, etc.
  config_value    String   // JSON or simple string depending on key
  effective_from  DateTime
  effective_to    DateTime?
  description     String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([config_key, effective_from])
  @@index([config_key])
  @@index([effective_from, effective_to])
}

model MinimumStaffingRequirement {
  id                String @id @default(cuid())
  roster_group      RosterGroup
  reporting_group   ReportingGroup
  min_staff_count   Int
  effective_from    DateTime
  effective_to      DateTime?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@unique([roster_group, reporting_group, effective_from])
  @@index([roster_group, reporting_group])
  @@index([effective_from, effective_to])
}

// ============================================================================
// ROSTER EXECUTION
// ============================================================================

model RosterWeek {
  id                String   @id @default(cuid())
  week_start_date   DateTime
  week_end_date     DateTime
  status            RosterWeekStatus @default(DRAFT)
  generated_by      String?
  published_at      DateTime?
  published_by      String?
  notes             String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  // Relations
  roster_assignments       RosterAssignment[]
  rl_proposals             RLProposal[]
  daily_operational_duties DailyOperationalDuty[]
  roster_overrides         RosterOverride[]
  validation_results       RosterValidationResult[]
  generation_job           RosterGenerationJob?

  @@unique([week_start_date])
  @@index([status])
  @@index([week_start_date, week_end_date])
}

model RosterAssignment {
  id                           String   @id @default(cuid())
  roster_week_id               String
  staff_id                     String
  assignment_date              DateTime
  assignment_code              AssignmentCode
  normal_rotation_state        NormalRotationState?  // Independent from assignmentCode (critical)
  reporting_group              ReportingGroup
  reporting_time               DateTime?             // Specific time for this assignment (from RosterConfig)
  shift_start                  DateTime?
  shift_end                    DateTime?
  is_manual_override           Boolean  @default(false)
  created_at                   DateTime @default(now())
  updated_at                   DateTime @updatedAt

  // Relations
  roster_week                  RosterWeek @relation(fields: [roster_week_id], references: [id], onDelete: Restrict)
  staff                        Staff      @relation(fields: [staff_id], references: [id], onDelete: Restrict)
  rl_proposal_replaces         RLProposal? @relation("replaces_assignment")

  @@unique([roster_week_id, staff_id, assignment_date])
  @@index([roster_week_id])
  @@index([staff_id])
  @@index([assignment_date])
  @@index([assignment_code])
  @@index([normal_rotation_state])
  @@index([is_manual_override])
}

model RLProposal {
  id                              String   @id @default(cuid())
  roster_week_id                  String
  staff_id                        String
  shortage_date                   DateTime
  roster_group                    RosterGroup
  status                          RLProposalStatus @default(PROPOSED)
  original_roster_assignment_id   String?          @unique // Reference to 1ST/2ND being replaced (audit trail)
  reasoning                       String?
  proposed_at                     DateTime @default(now())
  approved_at                     DateTime?
  approved_by                     String?
  rejected_at                     DateTime?
  rejected_reason                 String?
  created_at                      DateTime @default(now())
  updated_at                      DateTime @updatedAt

  // Relations
  roster_week                     RosterWeek      @relation(fields: [roster_week_id], references: [id], onDelete: Restrict)
  staff                           Staff           @relation(fields: [staff_id], references: [id], onDelete: Restrict)
  original_assignment             RosterAssignment? @relation("replaces_assignment", fields: [original_roster_assignment_id], references: [id], onDelete: Restrict)
  approver                        User?           @relation("rl_approved_by", fields: [approved_by], references: [id], onDelete: Restrict)

  @@unique([roster_week_id, staff_id, shortage_date])
  @@index([roster_week_id])
  @@index([staff_id])
  @@index([status])
  @@index([shortage_date])
  @@index([roster_group])
}

model DailyOperationalDuty {
  id                String @id @default(cuid())
  roster_week_id    String
  staff_id          String
  duty_date         DateTime
  duty_start_time   DateTime      // BRK-specific: duty period start
  duty_end_time     DateTime      // BRK-specific: duty period end
  duty_code         DutyCode @default(BREAK)
  reporting_time    DateTime?     // Always FIRST_SHIFT_REPORTING_TIME for BRK
  is_approved       Boolean @default(false)
  approval_required Boolean @default(true)  // Always true for MVP
  approved_by       String?
  approved_at       DateTime?
  rejection_reason  String?
  classification    String @default("OPERATIONAL_BRK")  // "PREPLANNED_BRK" or "OPERATIONAL_BRK"
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  // Relations
  roster_week       RosterWeek @relation(fields: [roster_week_id], references: [id], onDelete: Restrict)
  staff             Staff      @relation(fields: [staff_id], references: [id], onDelete: Restrict)
  approver          User?      @relation("brk_approved_by", fields: [approved_by], references: [id], onDelete: Restrict)

  @@index([roster_week_id])
  @@index([staff_id])
  @@index([duty_date])
  @@index([is_approved])
  @@index([classification])
  @@index([duty_start_time, duty_end_time])
}

// ============================================================================
// ROSTER GENERATION & VALIDATION
// ============================================================================

model RosterGenerationJob {
  id           String   @id @default(cuid())
  roster_week_id String @unique
  status       RosterGenerationJobStatus @default(PENDING)
  started_at   DateTime?
  completed_at DateTime?
  error_message String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  // Relations
  roster_week  RosterWeek @relation(fields: [roster_week_id], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([created_at])
}

model RosterValidationResult {
  id                String @id @default(cuid())
  roster_week_id    String
  validation_type   ValidationType
  severity          ValidationSeverity
  message           String
  affected_staff_id String?
  affected_date     DateTime?
  resolved          Boolean @default(false)
  created_at        DateTime @default(now())
  resolved_at       DateTime?
  resolved_by       String?

  // Relations
  roster_week       RosterWeek @relation(fields: [roster_week_id], references: [id], onDelete: Cascade)
  resolver          User?      @relation(fields: [resolved_by], references: [id], onDelete: Restrict)

  @@index([roster_week_id])
  @@index([validation_type])
  @@index([severity])
  @@index([resolved])
}

model RosterOverride {
  id                String   @id @default(cuid())
  roster_week_id    String
  staff_id          String
  override_date     DateTime
  original_assignment_code AssignmentCode
  new_assignment_code      AssignmentCode
  reason            String
  authorized_by     String
  override_at       DateTime @default(now())
  created_at        DateTime @default(now())

  // Relations
  roster_week       RosterWeek @relation(fields: [roster_week_id], references: [id], onDelete: Restrict)
  staff             Staff      @relation(fields: [staff_id], references: [id], onDelete: Restrict)
  authorizer        User       @relation(fields: [authorized_by], references: [id], onDelete: Restrict)

  @@index([roster_week_id])
  @@index([staff_id])
  @@index([override_date])
  @@index([authorized_by])
}

// ============================================================================
// OPERATIONS: RESERVATIONS
// ============================================================================

model ReservationGroup {
  id           String   @id @default(cuid())
  name         String
  capacity     Int
  description  String?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  // Relations
  reservations Reservation[]
  table_allocations TableAllocation[]

  @@index([is_active])
}

model Reservation {
  id                    String   @id @default(cuid())
  reservation_group_id  String
  guest_name           String
  party_size           Int
  reservation_time     DateTime
  notes                String?
  status               String   @default("CONFIRMED")  // CONFIRMED, SEATED, COMPLETED, CANCELLED
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  // Relations
  reservation_group    ReservationGroup @relation(fields: [reservation_group_id], references: [id], onDelete: Restrict)
  table_allocations    TableAllocation[]

  @@index([reservation_group_id])
  @@index([reservation_time])
  @@index([status])
}

model Section {
  id        String   @id @default(cuid())
  name      String
  capacity  Int
  is_active Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  tables    Table[]

  @@index([is_active])
}

model Table {
  id           String   @id @default(cuid())
  section_id   String
  table_number String
  capacity     Int
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  // Relations
  section           Section @relation(fields: [section_id], references: [id], onDelete: Restrict)
  table_allocations TableAllocation[]

  @@unique([section_id, table_number])
  @@index([section_id])
  @@index([is_active])
}

model TableAllocation {
  id                   String   @id @default(cuid())
  reservation_id       String
  reservation_group_id String
  table_id             String
  allocated_at         DateTime @default(now())
  released_at          DateTime?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  // Relations
  reservation          Reservation       @relation(fields: [reservation_id], references: [id], onDelete: Cascade)
  reservation_group    ReservationGroup  @relation(fields: [reservation_group_id], references: [id], onDelete: Restrict)
  table               Table              @relation(fields: [table_id], references: [id], onDelete: Restrict)

  @@index([reservation_id])
  @@index([reservation_group_id])
  @@index([table_id])
}

// ============================================================================
// OPERATIONS: INVENTORY & STOCK
// ============================================================================

model InventoryItem {
  id            String   @id @default(cuid())
  name          String
  category      String
  unit          String   // e.g., "kg", "l", "pcs"
  reorder_level Int
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relations
  stock_counts  StockCount[]
  sales         Sale[]

  @@index([category])
  @@index([is_active])
}

model StockCount {
  id                String   @id @default(cuid())
  inventory_item_id String
  quantity          Int
  recorded_at       DateTime @default(now())
  recorded_by       String?
  notes             String?
  created_at        DateTime @default(now())

  // Relations
  inventory_item    InventoryItem @relation(fields: [inventory_item_id], references: [id], onDelete: Restrict)

  @@index([inventory_item_id])
  @@index([recorded_at])
}

model Sale {
  id                String   @id @default(cuid())
  inventory_item_id String
  quantity_sold     Int
  sale_price        Decimal
  sale_date         DateTime
  notes             String?
  created_at        DateTime @default(now())

  // Relations
  inventory_item    InventoryItem @relation(fields: [inventory_item_id], references: [id], onDelete: Restrict)

  @@index([inventory_item_id])
  @@index([sale_date])
}

// ============================================================================
// OPERATIONS: TASKS
// ============================================================================

model TaskTemplate {
  id           String   @id @default(cuid())
  title        String
  description  String?
  estimated_duration_minutes Int
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  // Relations
  tasks        Task[]

  @@index([is_active])
}

model Task {
  id                String   @id @default(cuid())
  task_template_id  String
  assigned_to       String?
  due_date          DateTime?
  status            String   @default("PENDING")  // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  priority          String   @default("NORMAL")   // LOW, NORMAL, HIGH, URGENT
  notes             String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  // Relations
  task_template     TaskTemplate @relation(fields: [task_template_id], references: [id], onDelete: Restrict)

  @@index([task_template_id])
  @@index([assigned_to])
  @@index([status])
  @@index([due_date])
  @@index([priority])
}

// ============================================================================
// AUDIT LOG (Generic)
// ============================================================================

model AuditLog {
  id            String   @id @default(cuid())
  entity_type   String   // e.g., "RosterAssignment", "RLProposal", "DailyOperationalDuty"
  entity_id     String
  action        String   // "CREATE", "UPDATE", "DELETE", "APPROVE", "REJECT"
  actor_id      String?
  previous_state String? @db.Text  // JSON
  new_state      String? @db.Text  // JSON
  reason         String?
  created_at     DateTime @default(now())

  @@index([entity_type])
  @@index([entity_id])
  @@index([action])
  @@index([actor_id])
  @@index([created_at])
}

