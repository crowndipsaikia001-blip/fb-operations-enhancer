# .env.example
# Copy this file to .env.local and fill in real values. DO NOT commit real secrets.

# Supabase - required for client and server usage
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-public-key

# Server-only service role key - keep this secret (do NOT put in client-exposed files)
SUPABASE_SERVICE_ROLE_KEY=service-role-key

# Optional: Port the dev server should run on (defaults to 3000)
PORT=3000
